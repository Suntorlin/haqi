# Dependencies
**/node_modules/

# Build output
**/dist/
**/.vitepress/cache/
**/dist-exe/
**/*.tsbuildinfo
hub/src/web/embeddedAssets.generated.ts

# Downloaded tools (fetched at build time)
hub/tools/tunwg/tunwg-*
hub/tools/tunwg/*.exe

# Env files (can contain secrets)
**/.env
**/.env.*
**/.env*.local

# Logs
**/*.log
**/*-debug.log
**/*-error.log
npm-debug.log*

# Coverage
coverage/

# OS / IDE
**/.DS_Store
.idea/
.vscode/
**/*.swp
**/*.swo

# Claude local settings
.claude/settings.local.json
localdocs/
execplan/

# Generated npm bundle output (local)
cli/npm/main/
.ace-tool/

# Never commit (the repo is public; scripts/safety/check-public-safety.ts blocks these too)
.playwright-mcp/
.omx/
test-results/
playwright-report/
artifacts/
**/dist.prev-*/
**/dist.new*/
/*.png
/*.jpg
/*.webp
/*.mp4
/*.webm
**/*.har

# Private names for the public-safety check (never commit)
.public-safety.local
