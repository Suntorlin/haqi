#!/usr/bin/env bash
# This repo is public: check every commit about to be pushed.
# See scripts/safety/check-public-safety.ts.
set -euo pipefail
if ! command -v bun >/dev/null 2>&1; then
    echo "[public-safety] bun not found; skipping the pre-push check." >&2
    exit 0
fi
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue # deleting a branch
    if [ "$remote_sha" = "$zero" ]; then
        # New branch: everything not already on the remote's default branch.
        base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
        range="${base:+$base..}$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi
    echo "[public-safety] checking $local_ref ($range)"
    bun "$root/scripts/safety/check-public-safety.ts" --range "$range" || status=1
done
exit $status
